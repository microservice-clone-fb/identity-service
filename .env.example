# Server Configuration
PORT=10000

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://your-db-host:3306/clone_fb_identity?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=your-kafka-host:9092

# JWT Configuration
JWT_SIGNER_KEY=your_secure_jwt_signer_key_here_change_this_in_production
JWT_VALID_DURATION=1800
JWT_REFRESHABLE_DURATION=604800

# Microservices URLs
PROFILE_SERVICE_URL=https://your-profile-service.onrender.com/profile
FILE_SERVICE_URL=https://your-file-service.onrender.com/file

# Logging
LOG_LEVEL=INFO
